// Waybar custom module. Add "custom/drove" to modules-left/center/right.
"custom/drove": {
    "exec": "drove bar",
    "return-type": "json",
    "restart-interval": 5,
    "format": "{}",
    "tooltip": true,
    "on-click": "drove pick",
    "on-click-right": "drove next"
}

